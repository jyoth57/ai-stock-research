# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AIStockResearch
APP_ENV=development           # development | staging | production
DEBUG=true
SECRET_KEY=change-me-in-production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/aistockresearch
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose: deepseek | openai | ollama
LLM_PROVIDER=deepseek

# DeepSeek  https://platform.deepseek.com
# deepseek-chat     = DeepSeek-V3  (fast, excellent for Text-to-SQL)
# deepseek-reasoner = DeepSeek-R1  (chain-of-thought, best for complex queries)
DEEPSEEK_API_KEY=sk-...your-deepseek-key...
DEEPSEEK_MODEL=deepseek-chat

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama  local / free  (run: ollama pull deepseek-r1:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096

# ── Vector store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma

# ── Data paths ────────────────────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
REPORTS_DIR=data/reports

# ── NSE / Market data ─────────────────────────────────────────────────────────
OHLCV_START_DATE=2015-01-01
DEFAULT_INTERVAL=1d

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8501
